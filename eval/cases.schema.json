{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NL2SQL workshop eval case",
  "type": "object",
  "required": ["id", "question", "expected", "trap_axes", "difficulty"],
  "properties": {
    "id": {"type": "string", "pattern": "^CASE-[0-9]{4}$"},
    "question": {"type": "string", "minLength": 8},
    "expected": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["number", "table", "refusal"]},
        "value": {},
        "refusal_reason": {"type": "string"},
        "tolerance": {
          "description": "fractional tolerance for computed values (0 = exact)",
          "type": "number", "minimum": 0, "default": 0
        }
      },
      "anyOf": [
        {"properties": {"type": {"const": "refusal"}}, "required": ["type", "refusal_reason"]},
        {"properties": {"type": {"enum": ["number", "table"]}, "value": {}}}
      ]
    },
    "decision_register": {"type": "array", "items": {"type": "string"}},
    "trap_axes": {"type": "array", "minItems": 1,
                   "items": {"pattern": "^A([1-9]|10)$"}},
    "difficulty": {"enum": ["easy", "hard"]},
    "outcome_at_workshop": {"enum": ["refused", "answered_with_assumptions",
                                      "confidently_wrong", "unrun"]},
    "pair_id": {"type": "string"},
    "duplicate_of": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
